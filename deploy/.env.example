# Public DNS name used by Caddy for the dashboard/API.
IRRIGATION_SITE_ADDRESS=tracker.example.net

# Caddy Basic Auth. Generate the hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'a-long-random-password'
IRRIGATION_WEB_USERNAME=irrigation
IRRIGATION_WEB_PASSWORD_HASH='$2a$14$replace_with_a_real_caddy_hash'
